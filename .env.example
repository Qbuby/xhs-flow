# ── 服务 ─────────────────────────────────────────────
XHSFLOW_PORT=8787
XHSFLOW_HOST=127.0.0.1
# 启动后是否自动打开浏览器
XHSFLOW_OPEN_BROWSER=true

# ── 文本模型 ──────────────────────────────────────────
# 注意：baseURL 与 apiKey 必须成对匹配。智谱团队套餐 key 与按量付费 key 不通用。
#   团队套餐: https://open.bigmodel.cn/api/coding/paas/v4
#   按量付费: https://open.bigmodel.cn/api/paas/v4
#   OpenAI  : https://api.openai.com/v1
# 可选：glm-coding / glm-paygpt / openai / custom
XHSFLOW_LLM_PROFILE=glm-coding
XHSFLOW_LLM_API_KEY=
XHSFLOW_LLM_MODEL=glm-5.3
XHSFLOW_LLM_BASE_URL=

# ── 免费图库 ────────────────────────────────────────
# 默认用 Wikimedia Commons，**完全免注册**，直接可用。
# 想让配图更有「品牌感」就补一个 key（都是注册即用、无需审核）：
#   Pexels   https://www.pexels.com/api/     —— 不强制署名，URL 干净，推荐
#   Pixabay  https://pixabay.com/api/docs/   —— 同样只要一个 key
#   Unsplash https://unsplash.com/developers —— 需要建应用且强制署名，兼容性保留
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── 抓取节流（防风控，保守为上）────────────────────────
XHSFLOW_SCRAPE_CONCURRENCY=1
XHSFLOW_SCRAPE_AVG_DELAY_MS=6000
XHSFLOW_SCRAPE_DELAY_SIGMA=0.6

# ── 定时策略（crontab 表达式，本地时区）────────────────
# 默认 10:20（刻意避开整点和等间隔 —— 整点定时的规律性本身就是特征）
XHSFLOW_SCHEDULE_GENERATE=20 10 * * *
# 默认一天三次、时刻错开。原来「每两小时整点」等于对外宣告这是定时任务。
XHSFLOW_SCHEDULE_PUBLISH=25 10,16,21 * * *

# ── 发布 ─────────────────────────────────────────────
# true=自动发布已通过的草稿；false=始终需要手动点发布
XHSFLOW_PUBLISH_AUTO=false
# 单次发布间隔（秒），防风控。实际会叠加对数正态抖动，不是固定值。
XHSFLOW_PUBLISH_INTERVAL_SEC=45

# ── 防风控 ───────────────────────────────────────────
# 2026-10-10 本账号因「账号浏览行为异常或不规律，如使用第三方工具（如 AI）
# 进行模拟浏览，与真人操作习惯不符」被限制曝光一周。此后所有自动化浏览都要
# 过这几道闸：每日访问额度、最小间隔、安静时段、拟人节奏。
# 「每日额度 / 最小间隔」写在代码里（server/src/util/human.ts 的 DAILY_QUOTA
# 和 MIN_GAP_MIN），不当成配置项暴露 —— 这类上限调松了就等于关掉防护。

# 安静时段（本地时间，跨零点支持）。自动任务在此期间不打开小红书。
# 真人不会在凌晨反复访问创作中心，而「凌晨三点的规律访问」正是风控的判据之一。
# 留空 = 不启用。
XHSFLOW_QUIET_HOURS=23:30-07:30

# 用本机真实安装的 Chrome 而不是 Playwright 自带的 Chromium。
# 自带 Chromium 的版本号不在 Chrome 的发布序列里、缺 Widevine，
# 离线就能判定「这不是真人用的浏览器」。装了 Chrome 就保持 true。
XHSFLOW_USE_REAL_CHROME=true
# 一般不用填，程序会从 Chrome 安装目录自动读主版本号。
# 只有在读不到（非标准安装路径）时才需要手动指定。
# XHSFLOW_CHROME_VERSION=154
# 非标准安装位置时指定 chrome.exe 路径
# XHSFLOW_CHROME_PATH=