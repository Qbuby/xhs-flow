# ── 服务 ─────────────────────────────────────────────
XHSFLOW_PORT=8787
XHSFLOW_HOST=127.0.0.1
# 启动后是否自动打开浏览器
XHSFLOW_OPEN_BROWSER=true

# ── 文本模型 ──────────────────────────────────────────
# 注意：baseURL 与 apiKey 必须成对匹配。智谱团队套餐 key 与按量付费 key 不通用。
#   团队套餐: https://open.bigmodel.cn/api/coding/paas/v4
#   按量付费: https://open.bigmodel.cn/api/paas/v4
#   OpenAI  : https://api.openai.com/v1
# 可选：glm-coding / glm-paygpt / openai / custom
XHSFLOW_LLM_PROFILE=glm-coding
XHSFLOW_LLM_API_KEY=
XHSFLOW_LLM_MODEL=glm-5.3
XHSFLOW_LLM_BASE_URL=

# ── 免费图库 ────────────────────────────────────────
# 默认用 Wikimedia Commons，**完全免注册**，直接可用。
# 想让配图更有「品牌感」就补一个 key（都是注册即用、无需审核）：
#   Pexels   https://www.pexels.com/api/     —— 不强制署名，URL 干净，推荐
#   Pixabay  https://pixabay.com/api/docs/   —— 同样只要一个 key
#   Unsplash https://unsplash.com/developers —— 需要建应用且强制署名，兼容性保留
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── 抓取节流（防风控，保守为上）────────────────────────
XHSFLOW_SCRAPE_CONCURRENCY=1
XHSFLOW_SCRAPE_AVG_DELAY_MS=6000
XHSFLOW_SCRAPE_DELAY_SIGMA=0.6

# ── 定时策略（crontab 表达式，本地时区）────────────────
# 默认 09:30
XHSFLOW_SCHEDULE_GENERATE=30 9 * * *
XHSFLOW_SCHEDULE_PUBLISH=0 */2 * * *

# ── 发布 ─────────────────────────────────────────────
# true=自动发布已通过的草稿；false=始终需要手动点发布
XHSFLOW_PUBLISH_AUTO=false
# 单次发布间隔（秒），防风控
XHSFLOW_PUBLISH_INTERVAL_SEC=45